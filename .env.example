# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application Insights Configuration (required when LOCAL_TRACING_ENABLED=false)
# Get this from your Azure Application Insights resource
# Format: InstrumentationKey=xxx;IngestionEndpoint=https://xxx.in.applicationinsights.azure.com/;LiveEndpoint=https://xxx.livediagnostics.monitor.azure.com/
APPINSIGHTS_CONNECTIONSTRING=

# Tracing Configuration - set to true for local development to disable remote tracing
LOCAL_TRACING_ENABLED=true

# Azure Voice Services
AZURE_VOICE_ENDPOINT=
AZURE_VOICE_KEY=

# Cosmos DB Connection
COSMOSDB_CONNECTION=

# Storage Configuration
SUSTINEO_STORAGE=

# Azure Image Services
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
BASE_URL=http://localhost:8000

# Azure AI Project Configuration (for demo_agent.py)
PROJECT_ENDPOINT=
AZURE_AI_CONNECTION_ID=
MODEL_DEPLOYMENT_NAME=